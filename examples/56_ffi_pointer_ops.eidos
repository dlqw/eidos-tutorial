// 56_ffi_pointer_ops.eidos — 指针操作：空指针、算术、读写

import std.Ffi
main :: Int -> Int need ffi, io
{
    _ => {
        // 空指针
        null := Ffi.null_pointer();
        is_null := Ffi.is_null(null);       // true
        not_null := Ffi.is_null(Ffi.malloc(8)); // false

        // 分配内存
        buf := Ffi.malloc(24);

        // 写入 i64 值（每个占 8 字节）
        Ffi.store[Int](buf, 100);
        Ffi.store[Int](Ffi.offset_bytes(buf, 8), 200);
        Ffi.store[Int](Ffi.offset_bytes(buf, 16), 300);

        // 读取
        a := Ffi.load[Int](buf);
        b := Ffi.load[Int](Ffi.offset_bytes(buf, 8));
        c := Ffi.load[Int](Ffi.offset_bytes(buf, 16));

        println(a + b + c);  // 600

        0
    }
}

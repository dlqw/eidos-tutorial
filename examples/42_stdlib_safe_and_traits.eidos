import std.Option
import std.Result
import std.Ordering
import std.Seq
import std.Text
import std.Traversable

sum_right :: Int -> Int -> Int
{
    x => acc => x + acc
}

sum_left :: Int -> Int -> Int
{
    acc => x => acc + x
}

duplicate :: Int -> Seq[Int]
{
    x => [x, x]
}

positive_opt :: Int -> Option[Int]
{
    x => if x > 0 then { Some(x + 1) } else { None() }
}

inc :: Int -> Int
{
    x => x + 1
}

add :: Int -> Int -> Int
{
    left => right => left + right
}

is_three :: Ref[Int] -> Bool
{
    x => *x == 3
}

lift_plus_ten :: Int -> Option[Int]
{
    x => Some(x + 10)
}

lift_result :: Int -> Result.With[String, Int]
{
    x => Ok(x + 10)
}

positive_result :: Int -> Result.With[String, Int]
{
    x => if x > 0 then { Ok(x + 1) } else { Err("bad") }
}

main :: Unit -> Int
{
    _ => {
        first_head := [10, 20, 30].head() ?? 0;
        tail_len := match tail([10, 20, 30])
        {
            Some(rest) => len(ref rest),
            None() => 0
        };
        found := [1, 2, 3, 4].find(is_three) ?? 0;
        folded := [1, 2, 3].fold_right(0, sum_right);
        functor_list := inc <$> [1, 2];
        functor_list_len := len(ref functor_list);
        applicative_list_head := ([add(10), add(20)] <*> [1, 2]).head() ?? 0;
        monad_list := [1, 2] >>= duplicate;
        monad_list_len := len(ref monad_list);

        text_index := "eidos".index_of_or("id", -1);
        text_last_index := "banana".last_index_of_or("ana", -1);
        text_code_ok := if "ab".char_code_at_or(1, 0) > 0 then { 1 } else { 0 };
        fallback_char := "ab".char_at_or(9, 'z');

        option_functor := (inc <$> Some(2)) ?? 0;
        option_pure := Option.pure(6) ?? 0;
        option_applicative := (Some(add(20)) <*> Some(3)) ?? 0;
        option_folded := Some(3).fold_left(10, sum_left);
        option_traversed := match Option.traverse(Some(2), positive_opt)
        {
            Some(inner) => inner ?? 0,
            None() => 0
        };
        option_bind := (Some(2) >>= lift_plus_ten) ?? 0;
        option_equal := if eq(Some(1), Some(1)) then { 1 } else { 0 };
        option_compare := if compare(None(), Some(1)) |> is_lt then { 1 } else { 0 };
        option_shown := show(Some(8));

        result_function: Result.With[String, Int -> Int] := Ok(add(30));
        result_value: Result.With[String, Int] := Ok(4);
        result_applicative := apply(result_function, result_value).unwrap_or(0);
        result_folded := Ok(3).fold_right(10, sum_right);
        traversable_result_input: Result.With[String, Int] := Ok(2);
        result_traversed := match Result.traverse(traversable_result_input, positive_result)
        {
            Ok(inner) => inner.unwrap_or(0),
            Err(_) => 0
        };
        result_compare := if compare(Err("a"), Ok(1)) |> is_lt then { 1 } else { 0 };
        result_shown := show(Ok(7));
        ordering_shown := 1.compare(2) |> Ordering.show;
        list_traversed := match Traversable.traverse([1, 2], positive_opt)
        {
            Some(values) => values.head() ?? 0,
            None() => 0
        };

        if fallback_char == 'z' &&
           option_shown == "Some(8)" &&
           result_shown == "Ok(7)" &&
           ordering_shown == "Less" then {
            first_head + tail_len + found + folded + functor_list_len + applicative_list_head + monad_list_len + text_index + text_last_index + text_code_ok + option_functor + option_pure + option_applicative + option_folded + option_traversed + option_bind + option_equal + option_compare + result_applicative + result_folded + result_traversed + result_compare + list_traversed
        }
        else { 0 }
    }
}

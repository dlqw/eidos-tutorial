import std.Option

independent :: Unit -> Option[Int]
{
    do {
        left <- Some(20)
        right <- Some(21)
        Some(left + right)
    }
}

dependent :: Int -> Option[Int]
{
    seed => do {
        first <- Some(seed)
        second <- Some(first + 1)
        Some(second)
    }
}

refutable :: Option[Int] -> Option[Int]
{
    value => do {
        Some(inner) <- Some(value)
        Some(inner + 1)
    }
}

main :: Unit -> Int
{
    independent_value := independent() ?? 0;
    dependent_value := dependent(20) ?? 0;
    matched_value := refutable(Some(20)) ?? 0;
    empty_value := refutable(None()) ?? 1;
    independent_value + dependent_value + matched_value + empty_value
}

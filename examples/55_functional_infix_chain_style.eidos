import std.Functions
import std.Seq
import std.Option
import std.Result

inc :: Int -> Int
{
    x => x + 1
}

double :: Int -> Int
{
    x => x * 2
}

add :: Int -> Int -> Int
{
    left => right => left + right
}

gt_two :: Ref[Int] -> Bool
{
    x => *x > 2
}

positive_opt :: Int -> Option[Int]
{
    x => if x > 0 then { Some(x + 1) } else { None() }
}

positive_result :: Int -> Result.With[String, Int]
{
    x => if x > 0 then { Ok(x + 1) } else { Err("bad") }
}

main :: Unit -> Int
{
    _ => {
        piped := 3 |> inc |> double;
        composed := 3 |> (inc >>> double);
        chained := 3.inc().double();
        list_pipeline := [1, 2, 3].map(inc).filter(gt_two).fold_left(0, add);
        appended := [1, 2] <> [3, 4];
        appended_len := Seq.len(ref appended);
        mapped_option := (inc <$> Some(4)) ?? 0;
        applied_option := (Some(add(10)) <*> Some(5)) ?? 0;
        bound_option := (Some(2) >>= positive_opt) ?? 0;
        bound_result := (Ok(2) >>= positive_result).unwrap_or(0);

        piped + composed + chained + list_pipeline + appended_len + mapped_option + applied_option + bound_option + bound_result
    }
}

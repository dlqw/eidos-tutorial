import std.Seq
import std.Option
import std.Result

collapse_option_result :: Result[Option[Int], String] -> Int
{
    Ok(inner) => inner ?? 0,
    Err(_) => 0
}

collapse_seq_result :: Result[Seq[Int], String] -> Int
{
    Ok(values) => values.head_or(0),
    Err(_) => 0
}

collapse_result_result :: Result[Result[Int, String], String] -> Int
{
    Ok(inner) => inner.unwrap_or(0),
    Err(_) => 0
}

sequence_result_result :: Result[Result[Int, String], String] -> Result[Result[Int, String], String]
{
    value => value |> sequence
}

main :: Unit -> Int
{
    _ => {
        option_direct := Some(Ok(1)) |> sequence |> collapse_option_result;
        option_err := match sequence(Some(Err("bad")))
        {
            Ok(Some(value)) => value,
            Err(_) => 1
        };

        list_direct := [Ok(2), Ok(3)] |> sequence |> collapse_seq_result;
        list_err := match sequence([Ok(2), Err("bad")])
        {
            Ok(values) => Seq.len(ref values),
            Err(_) => 1
        };

        result_direct := Ok(Ok(4)) |> sequence_result_result |> collapse_result_result;
        result_inner_err := match sequence_result_result(Ok(Err("inner")))
        {
            Ok(inner) => match inner
            {
                Ok(value) => value,
                Err(_) => 1
            },
            Err(_) => 0
        };

        result_outer_err := match sequence_result_result(Err("outer"))
        {
            Ok(_) => 0,
            Err(_) => 1
        };

        option_direct + option_err + list_direct + list_err + result_direct + result_inner_err + result_outer_err
    }
}

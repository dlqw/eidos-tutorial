import std.Applicative
import std.Seq
import std.Option
import std.Result
import std.Traversable

Triple[A, B, C] :: type {
    Triple:: type(A, B, C)
}

KeepEdges[L, R, X] :: type = Triple[L, X, R];
BoxedResult[E, T] :: type = Result[T, E];
DeepBoxedResult[E, T] :: type = BoxedResult[E, T];

join_ctx :: String -> String -> String
{
    left => right => left ++ "|" ++ right
}

ApplicativeKeepEdgesStringBool :: instance Applicative.Applicative[KeepEdges[String, Bool]] {
    pure[A] :: A -> KeepEdges[String, Bool, A]
    {
        value => Triple("pure", value, true)
    }
    apply[A, B, E: effects] :: KeepEdges[String, Bool, A -> B need E] -> KeepEdges[String, Bool, A] -> KeepEdges[String, Bool, B] need E
    {
        Triple(left_ctx, f, left_ok), Triple(right_ctx, value, right_ok) => Triple(join_ctx(left_ctx, right_ctx), value |> f, left_ok && right_ok)
    }
}

ApplicativeDeepBoxedResultString :: instance Applicative.Applicative[DeepBoxedResult[String]] {
    pure[A] :: A -> DeepBoxedResult[String, A]
    {
        value => Ok(value)
    }
    apply[A, B, E: effects] :: DeepBoxedResult[String, A -> B need E] -> DeepBoxedResult[String, A] -> DeepBoxedResult[String, B] need E
    {
        Ok(f), Ok(value) => Ok(value |> f),
        Err(error), _ => Err(error),
        _, Err(error) => Err(error)
    }
}

generic_sequence[A, T: kind2 : Traversable.Traversable[T], G: kind2 : Applicative.Applicative[G]] :: T[G[A]] -> G[T[A]]
{
    values => values |> Traversable.sequence
}

collapse_open_result :: Triple[String, Result[Int, String], Bool] -> Int
{
    Triple(_, inner, ok) => if ok then {
        inner.unwrap_or(0)
    } else { 0 }
}

collapse_open_seq :: Triple[String, Seq[Int], Bool] -> Int
{
    Triple(_, values, ok) => if ok then {
        values.head_or(0)
    } else { 0 }
}

collapse_open_option :: Triple[String, Option[Int], Bool] -> Int
{
    Triple(_, inner, ok) => if ok then {
        inner ?? 0
    } else { 0 }
}

collapse_option_result :: Result[Option[Int], String] -> Int
{
    Ok(inner) => inner ?? 0,
    Err(_) => 0
}

collapse_seq_result :: Result[Seq[Int], String] -> Int
{
    Ok(values) => values.head_or(0),
    Err(_) => 0
}

collapse_result_result :: Result[Result[Int, String], String] -> Int
{
    Ok(inner) => inner.unwrap_or(0),
    Err(_) => 0
}

main :: Unit -> Int
{
    _ => {
        open_result_direct := Ok(Triple("edge", 2, true)) |> sequence |> collapse_open_result;
        open_result_via_helper := Ok(Triple("edge", 2, true)) |> generic_sequence |> collapse_open_result;
        open_list_direct := [Triple("left", 3, true), Triple("right", 4, true)] |> sequence |> collapse_open_seq;
        open_list_via_helper := [Triple("left", 3, true), Triple("right", 4, true)] |> generic_sequence |> collapse_open_seq;
        open_option_direct := Some(Triple("solo", 5, true)) |> sequence |> collapse_open_option;
        open_option_via_helper := Some(Triple("solo", 5, true)) |> generic_sequence |> collapse_open_option;

        option_result_direct := Some(Ok(6)) |> sequence |> collapse_option_result;
        option_result_via_helper := Some(Ok(6)) |> generic_sequence |> collapse_option_result;
        list_result_direct := [Ok(7), Ok(8)] |> sequence |> collapse_seq_result;
        list_result_via_helper := [Ok(7), Ok(8)] |> generic_sequence |> collapse_seq_result;
        result_result_direct := Ok(Ok(9)) |> sequence |> collapse_result_result;
        result_result_via_helper := Ok(Ok(9)) |> generic_sequence |> collapse_result_result;

        open_result_direct + open_result_via_helper + open_list_direct + open_list_via_helper +
        open_option_direct + open_option_via_helper + option_result_direct + option_result_via_helper +
        list_result_direct + list_result_via_helper + result_result_direct + result_result_via_helper
    }
}

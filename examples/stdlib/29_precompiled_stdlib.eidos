import std.Functions
import std.File
import std.Option
import std.Ordering
import std.Seq
import std.Result
import std.Traits
import std.Text
import std.Traversable

inc :: Int -> Int { x => x + 1 }
add :: Int -> Int -> Int { left => right => left + right }
lift_result :: Int -> Result.With[String, Int] { x => Ok(x + 1) }
recover_err :: String -> Result[Int, String] { _ => Ok(5) }
gt_two :: Ref[Int] -> Bool { x => *x > 2 }
sum_left :: Int -> Int -> Int { acc => x => acc + x }
sum_right :: Int -> Int -> Int { x => acc => x + acc }
pair_sum :: (Int, Int) -> Int { (left, right) => left + right }
eq_self[T: Traits.Eq] :: T -> Bool { x => x == x }
ord_self[T: Traits.Ord] :: T -> Bool { x => x <= x }
positive_opt :: Int -> Option[Int] { x => if x > 0 then { Some(x + 1) } else { None() } }
positive_result :: Int -> Result.With[String, Int] { x => if x > 0 then { Ok(x + 1) } else { Err("bad") } }

main :: Unit -> Int need io
{
    _ => {
        src_for_empty := "ab";
        src_for_opt := "ab";
        src_for_char := "ab";
        src_for_char_fallback := "ab";
        src_for_len := "ab";

        via_fn := 41 |> Functions.apply(inc);
        via_result := Ok(1).map(inc).and_then(lift_result).unwrap_or(0);
        via_result_recover := Err("oops").or_else(recover_err).unwrap_or(0);
        via_result_flatten := Ok(Ok(4)).flatten().unwrap_or(0);
        via_seq := [1, 2, 3].map(inc).filter(gt_two).fold_left(0, sum_left);
        via_list_zip := [1, 2, 3].zip_with([4, 5, 6], add).head() ?? 0;
        via_head := [1, 2, 3].head() ?? 0;
        via_tail := match tail([1, 2, 3])
        {
            Some(rest) => len(ref rest),
            None() => 0
        };
        via_fold_right := [1, 2, 3].fold_right(0, sum_right);
        via_option_zip := Some(2).zip(Some(3)).map_or(0, pair_sum);
        via_option_zip_with := Some(2).zip_with(Some(3), add) ?? 0;
        via_option_flatten := Some(Some(4)).flatten().map_or(0, inc);
        via_option_traverse := match Option.traverse(Some(2), positive_opt)
        {
            Some(inner) => inner ?? 0,
            None() => 0
        };
        traversable_result_input: Result.With[String, Int] := Ok(2);
        via_result_traverse := match Result.traverse(traversable_result_input, positive_result)
        {
            Ok(inner) => inner.unwrap_or(0),
            Err(_) => 0
        };
        via_list_traverse := match Traversable.traverse([1, 2], positive_opt)
        {
            Some(values) => values.head() ?? 0,
            None() => 0
        };
        via_text_char := match src_for_char.char_at_opt(1)
        {
            Some(c) => if c == 'b' then { 1 } else { 0 },
            None() => 0
        };
        via_text_fallback := if src_for_char_fallback.char_at_or(9, 'z') == 'z' then { 1 } else { 0 };
        via_text_index := "hello".index_of_or("ell", -1);
        via_text_last_index := "banana".last_index_of_or("ana", -1);
        via_text_trim := trim("  ok  ");
        via_file_fallback := read_text_or("eidos_tutorial_missing.txt", "fallback");
        via_file_status := File.last_success(());
        via_file_error := File.last_error(());
        via_text := src_for_opt.char_code_at_or(1, 0) + via_text_char + via_text_fallback + via_text_index + via_text_last_index + Text.len(src_for_len);
        via_ordering := via_head.compare(1).then_compare(0, 1);
        trait_ordering := 1.compare(2) |> Ordering.show;
        trait_text := show("ok");
        if !Text.empty(src_for_empty) &&
           is_ok(Ok(1)) &&
           is_err(Err("oops")) &&
           (Ok(1) |> ok |> is_some) &&
           (Err("oops") |> err |> is_some) &&
           is_lt(via_ordering) &&
           eq_self(41) &&
           ord_self('a') &&
           trait_ordering == "Less" &&
           trait_text == "ok" &&
           via_text_trim == "ok" &&
           via_file_fallback == "fallback" &&
           !via_file_status &&
           !(via_file_error == "") &&
           trim_start("  left") == "left" &&
           trim_end("right  ") == "right" &&
           is_blank("   ") then {
            via_fn + via_result + via_result_recover + via_result_flatten + via_seq + via_list_zip + via_head + via_tail + via_fold_right + via_option_zip + via_option_zip_with + via_option_flatten + via_option_traverse + via_result_traverse + via_list_traverse + via_text
        }
        else { 0 }
    }
}

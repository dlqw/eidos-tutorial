// 55_ffi_basic.eidos — FFI 基础：声明和调用 C 函数

// @[extern(c, ...)] 声明外部 C 函数，无函数体
// 编译器自动使用函数名作为 C 符号名

import std.Ffi

@[extern(c, name: "puts")]
write_c_string :: RawPtr -> Int need ffi;


main :: Int -> Int need ffi
{
    _ => {
        // 将 Eidos String 转为 C 字符串 (char*)
        msg := Ffi.to_c_string("Hello from Eidos!");
        write_c_string(msg);

        // 反向转换：C 字符串 → Eidos String
        // Ffi.from_c_string(ptr) → String

        0
    }
}
